DATABASE_URL="postgresql://apta:apta@localhost:5432/apta_db?schema=public"
PORT=3333
JWT_SECRET="troque-por-um-valor-aleatorio-seguro"

# Envio do protocolo de entrega por e-mail (Resend). Sem RESEND_API_KEY o
# envio automático fica desligado. EMAIL_MODO=log só imprime no console (dev).
RESEND_API_KEY=""
EMAIL_REMETENTE="Apta Contabilidade <documentos@contabilidadeapta.com.br>"
# EMAIL_MODO=log
# Endereço público do front, usado no link que vai no e-mail.
APP_URL="http://localhost:3000"

# WhatsApp do atendimento. "simulador" (padrão) não envia nada: as mensagens
# ficam entregues/lidas sozinhas e a tela permite simular mensagens de clientes.
# "evolution" fala com uma instância própria da Evolution API (self-hosted).
# WHATSAPP_PROVEDOR=simulador
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCE="apta"
# Chave que o webhook da Evolution precisa mandar de volta pra provar que é
# ela mesma chamando (não é a mesma coisa que EVOLUTION_API_KEY).
# WHATSAPP_WEBHOOK_TOKEN=""

# Motor do Agente Apta (resposta automática via Gemini). Sem GEMINI_API_KEY,
# conversas em modo AGENTE ficam só registradas, sem resposta automática.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"
